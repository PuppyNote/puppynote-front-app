# 이 파일을 복사해 .env / .env.dev / .env.prd 를 만드세요.
# EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 인라인됩니다.

# --- 백엔드 ---------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.puppynote.co.kr

# --- 네이티브 SDK 키 (빌드 타임 전용) --------------------------------------
KAKAO_NATIVE_APP_KEY=
GOOGLE_MAPS_API_KEY=

# --- 웹뷰 전환 (Phase 0) --------------------------------------------------
# 모바일 웹(puppynote-front-web) 진입 URL.
# 아직 배포 전이면 비워두세요. 쉘이 "웹 주소가 설정되지 않았습니다" 안내를 보여줍니다.
# 로컬 개발 시 예시:
#   - Android 에뮬레이터: http://10.0.2.2:3000
#   - iOS 시뮬레이터:     http://localhost:3000
#   - 실기기:             http://<개발PC IP>:3000
EXPO_PUBLIC_WEB_URL=

# true 로 두면 앱 진입 시 네이티브 화면 대신 WebView 쉘로 들어갑니다.
# 전체 화면 이식이 끝나기 전까지는 false 로 두세요.
EXPO_PUBLIC_WEBVIEW_MODE=false
