# 이 파일을 복사해 .env / .env.dev / .env.prd 를 만드세요.
# EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 인라인됩니다.

# --- 백엔드 ---------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.puppynote.co.kr

# --- 네이티브 SDK 키 (빌드 타임 전용) --------------------------------------
KAKAO_NATIVE_APP_KEY=
GOOGLE_MAPS_API_KEY=

# --- 웹뷰 전환 --------------------------------------------------------------
# 모바일 웹(front.puppynote.co.kr) 진입 URL. 비워두면 src/config/webview.ts의
# 기본값(https://front.puppynote.co.kr)을 씁니다. 로컬 웹 서버를 보려면 덮어쓰세요:
#   - Android 에뮬레이터: http://10.0.2.2:3000
#   - iOS 시뮬레이터:     http://localhost:3000
#   - 실기기:             http://<개발PC IP>:3000
EXPO_PUBLIC_WEB_URL=

# 기본값은 true(앱 진입 시 네이티브 화면 대신 WebView 쉘로 들어감)입니다.
# 네이티브 화면으로 잠시 되돌리려면 false로 설정하세요.
EXPO_PUBLIC_WEBVIEW_MODE=
